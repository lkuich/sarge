{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sarge-hosted",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "SARGE_BASE_DOMAIN": "track.sargetrack.app",
    "DEFAULT_ATTRIBUTION_TTL_DAYS": "28",
    "DIAGNOSTIC_EVENT_LOOKBACK_MINUTES": "60",
    "DIAGNOSTIC_EVENT_LIMIT_PER_SITE": "200",
    "OPENAI_SUMMARY_MODEL": "gpt-6-luna"
  },
  "services": [
    { "binding": "MANAGEMENT_MCP", "service": "sarge-www" }
  ],
  "triggers": {
    "crons": [
      "*/30 * * * *"
    ]
  },
  "routes": [
    {
      "pattern": "track.sargetrack.app/*",
      "zone_name": "sargetrack.app"
    },
    {
      "pattern": "*.sargetrack.app/*",
      "zone_name": "sargetrack.app"
    }
  ]
}
